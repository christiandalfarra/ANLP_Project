\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}Main leaderboard}{6}{subsection.6.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Main results: ROUGE F-measures (stemmed) on the clean 9-match test set, with bootstrap 95\% CIs on ROUGE-L (10\,000 resamples). $^{*}$~significantly below both fine-tuned conditions (paired bootstrap CI of the ROUGE-L difference vs.\ \texttt  {finetuned\_bart} excludes zero for all prompting rows; all differences are $\ge +0.08$). The fine-tuned LED--BART gap ($\Delta = -0.0004$, CI $[-0.042, +0.035]$) is \emph  {not} significant. \texttt  {led\_long\_few} is byte-identical to \texttt  {led\_long\_zero}: an implementation fallback ran the zero-shot prompt in its place (see Observation~3).}}{6}{table.caption.3}\protected@file@percent }
\newlabel{tab:main}{{3}{6}{Main results: ROUGE F-measures (stemmed) on the clean 9-match test set, with bootstrap 95\% CIs on ROUGE-L (10\,000 resamples). $^{*}$~significantly below both fine-tuned conditions (paired bootstrap CI of the ROUGE-L difference vs.\ \texttt {finetuned\_bart} excludes zero for all prompting rows; all differences are $\ge +0.08$). The fine-tuned LED--BART gap ($\Delta = -0.0004$, CI $[-0.042, +0.035]$) is \emph {not} significant. \texttt {led\_long\_few} is byte-identical to \texttt {led\_long\_zero}: an implementation fallback ran the zero-shot prompt in its place (see Observation~3)}{table.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Three central observations}{6}{subsection.6.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(1)~Fine-tuning beats the strongest prompting baseline by 55\%, and the gap is statistically significant.}{6}{subsection.6.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(2)~Long-context dominates among prompting baselines; among fine-tuned models the two pipelines are statistically indistinguishable.}{6}{subsection.6.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(3)~Zero-shot beats few-shot and CoT in both chunk-aggregate families; long-context prompting is insensitive to prompt style.}{7}{subsection.6.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces ROUGE-L by prompt style and model family. Zero-shot is best in every family among the styles actually run. $^{\ddagger }$~implementation fallback: the zero-shot prompt ran in place of few-shot (see Observation~3).}}{7}{table.caption.4}\protected@file@percent }
\newlabel{tab:prompts}{{4}{7}{ROUGE-L by prompt style and model family. Zero-shot is best in every family among the styles actually run. $^{\ddagger }$~implementation fallback: the zero-shot prompt ran in place of few-shot (see Observation~3)}{table.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}Factual faithfulness}{7}{subsection.6.3}\protected@file@percent }
\newlabel{sec:faith}{{6.3}{7}{Factual faithfulness}{subsection.6.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Faithfulness probes on the 9 test matches. \emph  {Both teams}: both team names mentioned. \emph  {Correct score}: reference scoreline stated with correct team orientation. \emph  {Scorer recall}: mean fraction of reference scorers named (fuzzy surname matching). \emph  {\#named}: mean distinct PERSON entities (spaCy) per summary. \emph  {NE prec.}: fraction of those named people that appear among the reference's people --- precision complements the recall-only probes. Precisions on fewer than two names per summary (parenthesised) rest on too small a denominator to interpret. Bold marks the headline: the ROUGE-best model never states the correct score, yet has the highest scorer recall.}}{7}{table.caption.5}\protected@file@percent }
\newlabel{tab:faith}{{5}{7}{Faithfulness probes on the 9 test matches. \emph {Both teams}: both team names mentioned. \emph {Correct score}: reference scoreline stated with correct team orientation. \emph {Scorer recall}: mean fraction of reference scorers named (fuzzy surname matching). \emph {\#named}: mean distinct PERSON entities (spaCy) per summary. \emph {NE prec.}: fraction of those named people that appear among the reference's people --- precision complements the recall-only probes. Precisions on fewer than two names per summary (parenthesised) rest on too small a denominator to interpret. Bold marks the headline: the ROUGE-best model never states the correct score, yet has the highest scorer recall}{table.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.4}Reference similarity vs.\ source grounding}{8}{subsection.6.4}\protected@file@percent }
